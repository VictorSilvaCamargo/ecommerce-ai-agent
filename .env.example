# Configurações da Aplicação
ENVIRONMENT=development
APP_NAME="Atendente IA - NovaLoja"
API_PORT=8000
API_HOST=0.0.0.0
API_KEY=nova-loja-secret-api-key-test
WEBHOOK_SECRET=supersecret-hmac-webhook-key-32chars

# Provedores de LLM (Em desenvolvimento/testes locais utiliza-se mock determinístico caso ausente)
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Banco de Dados Relacional & Vetorial (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg://novaloja:novalojapass@localhost:5432/novaloja_db
DATABASE_URL_TEST=postgresql+psycopg://novaloja:novalojapass@localhost:5433/novaloja_test_db

# Banco de Dados Não-Relacional (MongoDB)
MONGODB_URI=mongodb://root:mongopass@localhost:27017/
MONGODB_DATABASE=novaloja_audit

# Cache, Sessão e Fila (Redis 7)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Observabilidade (Langfuse & Prometheus)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
PROMETHEUS_METRICS_PATH=/metrics
